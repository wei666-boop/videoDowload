{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/clear": {
            "delete": {
                "description": "删除数据库中的所有下载历史记录",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "数据管理"
                ],
                "summary": "清空数据库",
                "responses": {
                    "200": {
                        "description": "Database cleared successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "清空数据库失败",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "请求方法不允许",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/download": {
            "post": {
                "description": "根据用户的不同需求来下载视频，支持纯音频、纯视频、带字幕、带缩略图等多种格式",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "下载服务"
                ],
                "summary": "下载视频",
                "parameters": [
                    {
                        "description": "下载配置信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.Config"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "下载成功，返回视频文件流",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "请求参数错误或下载失败",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/history": {
            "get": {
                "description": "获取所有视频下载的历史记录列表",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "历史记录"
                ],
                "summary": "获取下载历史",
                "responses": {
                    "200": {
                        "description": "下载历史记录列表",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.DownLoadHis"
                            }
                        }
                    },
                    "500": {
                        "description": "服务器内部错误",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.Config": {
            "type": "object",
            "properties": {
                "subtitle": {
                    "type": "string"
                },
                "thumbnail": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "model.DownLoadHis": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "time": {
                    "type": "string"
                },
                "uri": {
                    "type": "string"
                }
            }
        }
    }
}